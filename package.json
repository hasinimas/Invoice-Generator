{
  "name": "invoice-generator",
  "version": "1.0.0",
  "description": "Cross-platform desktop Sehasna Travels invoice generator built with Electron",
  "main": "main.js",
  "author": "Uthsara",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.uthsara.invoicegenerator",
    "productName": "Sehasna Travels Invoice Generator",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "invoiceTemplate.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}
